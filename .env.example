# Saarthi — the only environment variable the app needs.
#
# Postgres is required (SQLite was dropped so the app runs on serverless
# hosts like Vercel, whose filesystem is ephemeral/read-only and can't hold
# a writable SQLite file — see prisma/schema.prisma). Any Postgres works:
# a free Neon or Supabase project, Vercel Postgres, a local instance, or
# `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16`.
DATABASE_URL="postgresql://user:password@host:5432/saarthi?sslmode=require"

# Nothing else is required:
# - auth: scrypt password hashing + random session tokens (all in-app)
# - password vault: zero-knowledge — PBKDF2-SHA256 + AES-256-GCM run entirely
#   in your browser; the server never sees the master password
# - uploads (book EPUB/PDF files, content-library files, exercise photos,
#   progress photos) are stored inside the database itself — no media
#   folder or object-storage bucket to configure
