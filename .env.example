# Saarthi — the only environment variable the app needs.
#
# One SQLite file that you own, holding everything: accounts, transactions,
# journal entries, workouts, and every binary upload (book EPUBs, exercise
# photos, progress photos). No media folder, no object store, no third party.
#
# The path is relative to prisma/schema.prisma, so this resolves to
# <project-root>/db/custom.db.
DATABASE_URL="file:../db/custom.db"

# Nothing else is required:
# - auth: scrypt password hashing + random session tokens (all in-app)
# - password vault: zero-knowledge — PBKDF2-SHA256 + AES-256-GCM run entirely
#   in your browser; the server never sees the master password
#
# Note: a serverless host (Vercel and friends) CANNOT run this — their
# filesystem is ephemeral and read-only, so a writable SQLite file has nowhere
# to live. Self-host on anything with a real disk; see the README.
